#!/bin/bash

VERSION="0.2.0"

ENV_DIR="$HOME/.envman"

if [[ ! -d "$ENV_DIR" ]]; then
	mkdir -p "$ENV_DIR"
fi

## Util

Error() {
	if test "$#" -ne 1; then
		exit 255
	fi
	local err="$1"
	echo "Error: $err"
	echo "See -h for help"
	exit 1
}

Help() {
	# Display Help
	echo "Manage your environment with ease"
	echo "https://github.com/lretq/envman"
	echo
	echo "Syntax: envman [-h|-V] <subcommand>"
	echo "Subcommands:"
	echo "  activate: Activate other environment"
	echo "  active: Print currently active environment"
	echo "  delete: Delete environment"
	echo "  edit: Edit environment with \$EDITOR"
	echo "  help: Print this help text"
	echo "  list: List available environments"
	echo "  new: Create new environment"
	echo "  shell: Print command for executing the active env"
	echo "  version: Print short version info"
	echo
}

Version() {
	echo "Envman v$VERSION"
	echo "Copyright (c) Vincent Schweiger, 2024-2026"
}

# usage: argc argreq
chk_argc() {
	if test "$1" -ne "$2"; then
		Error "Illegal number of parameters"
	fi
}

chk_file() {
	if [[ ! -f "$1" ]]; then
		echo "Error: File doesn't exist"
		exit 1
	fi
}

link_points_to() {
	local link="$1"
	local target="$2"
	local resolved
	resolved="$(readlink -f "$link")"
	[[ "$resolved" == "$(readlink -f "$target")" ]]
}

## COMMANDS
sub_activate() {
	chk_argc "$#" 1

	local name="$1"
	local path="$ENV_DIR/$name.env"

	chk_file "$path"

	rm -f "$ENV_DIR/active"
	ln -s "$path" "$ENV_DIR/active"
}

sub_active() {
	chk_file "$ENV_DIR/active"

	local path="$(readlink -f "$ENV_DIR/active")"
	local rel="${path#"$ENV_DIR"/}"

	echo "Currently, '${rel%.env}' is active"
}

sub_delete() {
	chk_argc "$#" 1

	local name="$1"
	local path="$ENV_DIR/$name.env"

	if [[ ! -f "$path" ]]; then
		echo "Error: environment '$name' does not exist." >&2
		return 1
	fi

	read -rp "Delete environment '$name' (at: $path)? [y/N] " yn
	case "${yn,,}" in
		y|yes) ;;
		*) echo "Aborted."; return 0 ;;
	esac

	if [[ -f "$ENV_DIR/active" ]]; then
		if link_points_to "$ENV_DIR/active" "$path"; then
			rm -- "$ENV_DIR/active"
		fi
	fi

	rm -f -- "$path"
}

sub_list() {
	echo "Available environments:"
	shopt -s globstar nullglob
	for file in "$ENV_DIR"/**/*.env; do
		local rel="${file#"$ENV_DIR"/}"
		printf "\t%s\n" "${rel%.env}"
	done
	exit
}

sub_shell() {
	printf '[[ -f %q ]] && source %q\n' \
		"$ENV_DIR/active" \
		"$ENV_DIR/active"
}

sub_edit() {
	local path=""
	local name="$1"
	if [ ! -z "$name" ]; then
		path="$ENV_DIR/$name.env"
	else
		path="$ENV_DIR/active"
	fi

	chk_file "$path"

	"$EDITOR" "$path"
}

sub_new() {
	local name
	if [ "$#" -ge 1 ]; then
		name="$1"
	else
		read -rp "Environment name: " name
	fi

	# Sanitize name
	if [[ -z "$name" ]]; then
		echo "Error: environment name cannot be empty." >&2
		return 1
	fi

	if [[ "$name" == -* ]]; then
		echo "Error: environment name cannot start with '-'." >&2
		return 1
	fi

	if [[ "$name" =~ [^a-zA-Z0-9_.-/] ]]; then
		echo "Error: environment name may only contain letters, digits, '_', '-', '.' and '/'." >&2
		return 1
	fi

	if [[ "$name" =~ ^\. ]]; then
		echo "Error: environment name cannot start with '.'." >&2
		return 1
	fi

	if [[ "$name" == *..* ]]; then
		echo "Error: environment name cannot contain '..'." >&2
		return 1
	fi
	if [[ "${#name}" -gt 128 ]]; then
		echo "Error: environment name cannot exceed 64 characters." >&2
		return 1
	fi

	local path="$ENV_DIR/$name.env"
	echo "Creating new environment '$name'"
	mkdir -p "$(dirname "$path")" || true
	touch "$path"

	read -rp "Do you wish to edit the new environment? [y/N] " yn
	case "${yn,,}" in
		y|yes|j|ja)
			"$EDITOR" "$path"
			;;
	esac

	read -rp "Do you wish to activate the new environment? [y/N] " yn
	case "${yn,,}" in
		y|yes|j|ja)
			sub_activate "$name"
			;;
	esac

	exit
}

sub_help() {
	Help
	exit
}

sub_version() {
	Version
	exit
}

## Main program
subcommand=$1

if [ -z "$subcommand" ]; then
	Help
	exit
fi

case $subcommand in
*)
	shift
	if [[ ! $(type -t "sub_${subcommand}") == function ]]; then
		Error "'$subcommand' is not a known subcommand."
	fi
	"sub_${subcommand}" $@
	;;
esac
